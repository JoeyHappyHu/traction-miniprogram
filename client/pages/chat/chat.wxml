<!-- pages/chat/chat.wxml -->
<view class="chat-container">
  <!-- 对话消息列表 -->
  <view class="chat-messages">
    <view
      class="message message-{{item.role}}"
      wx:for="{{messages}}"
      wx:key="id"
    >
      <!-- AI头像 -->
      <view class="avatar avatar-ai" wx:if="{{item.role === 'ai'}}">
        <text class="avatar-text">T</text>
      </view>

      <!-- 消息气泡 -->
      <view class="bubble bubble-{{item.role}}">
        <text>{{item.content}}</text>
        <view class="typing-dots" wx:if="{{item.role === 'ai' && isStreaming && index === messages.length - 1}}">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>

      <!-- 用户头像 -->
      <view class="avatar avatar-user" wx:if="{{item.role === 'user'}}">
        <text class="avatar-text">我</text>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="chat-bottom safe-bottom">
    <!-- 生成卡牌按钮 -->
    <view class="card-btn-area" wx:if="{{isReady}}">
      <button class="btn-generate-card" bindtap="goToCards">
        生成我的卡牌
      </button>
    </view>

    <!-- 输入框 -->
    <view class="input-area">
      <input
        class="chat-input"
        placeholder="说说你的想法..."
        value="{{inputText}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        disabled="{{isSending}}"
        confirm-type="send"
      />
      <view
        class="send-btn {{inputText && !isSending ? 'active' : ''}}"
        bindtap="sendMessage"
      >
        <text class="send-icon">↑</text>
      </view>
    </view>
  </view>
</view>
