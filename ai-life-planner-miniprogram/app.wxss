/**app.wxss**/
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
  overflow: hidden;
  position: relative;
}

.chibi-illustration {
  width: 100%;
  height: 400rpx;
  background-size: cover;
  background-position: center;
}

.metric {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.metric:last-child {
  border-bottom: none;
}

.metric-title {
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.risk { color: #e74c3c; }
.execution { color: #3498db; }
.benefit { color: #27ae60; }

.chat-message {
  max-width: 80%;
  padding: 20rpx;
  border-radius: 20rpx;
  margin: 10rpx 0;
}

.user-message {
  background: #007aff;
  color: #fff;
  align-self: flex-end;
  border-bottom-right-radius: 4rpx;
}

.ai-message {
  background: #fff;
  color: #333;
  align-self: flex-start;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}