/* pages/cards/cards.wxss */
.cards-container {
  padding: 30rpx;
  background: #f8f9fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
  display: block;
}

.desc {
  font-size: 26rpx;
  color: #666;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.card-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
}

.chibi-illustration {
  height: 420rpx;
  background: #e0e0e0;
  background-size: cover;
  background-position: center;
}

.metrics {
  padding: 20rpx 30rpx;
}

.metric {
  margin-bottom: 24rpx;
}

.metric:last-child {
  margin-bottom: 0;
}

.metric-title {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.metric-desc {
  font-size: 26rpx;
  line-height: 1.5;
  color: #555;
}

.card-footer {
  padding: 20rpx 30rpx;
  background: #fafafa;
  font-weight: bold;
  text-align: center;
  border-top: 1rpx solid #eee;
}